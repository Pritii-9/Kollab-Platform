# Kollab Platform Environment Configuration
ENVIRONMENT=development
SECRET_KEY=kollab-dev-only-secret-key-must-change-in-prod-min32chars

# Database Configuration (PostgreSQL 15 + pgvector in Docker)
POSTGRES_USER=kollab_user
POSTGRES_PASSWORD=kollab_pass
POSTGRES_DB=kollab

# Redis Cache URL
REDIS_URL=redis://redis:6379/0

# Groq LLM API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=kollab-resumes-bucket

# Email Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
