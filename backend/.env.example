
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://kollab_user:kollab_pass@localhost:5432/kollab
POSTGRES_USER=kollab_user
POSTGRES_PASSWORD=kollab_pass
POSTGRES_DB=kollab
# JWT Auth
SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AWS S3 (resumes + report exports)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=kollab-resumes-bucket
# Groq AI (free, fast — Llama 3.1 70B)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile
# Email (OTP sending via SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_USE_TLS=true
# CORS
FRONTEND_URL=http://localhost:5173
# ETL Pipeline schedule
ETL_CRON_HOUR=2
ETL_CRON_MINUTE=0